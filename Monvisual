RunService.Heartbeat:Connect(function()
    if not settings.targetESPEnabled then
        if espHighlight then espHighlight:Destroy() espHighlight = nil end
        return
    end
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local closest, dist = nil, 5
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local targetHRP = p.Character.HumanoidRootPart
            local d = (targetHRP.Position - hrp.Position).Magnitude
            if d <= dist then
                local ray = Ray.new(hrp.Position, (targetHRP.Position - hrp.Position).Unit * d)
                local hit = workspace:FindPartOnRay(ray, char)
                if not hit or hit:IsDescendantOf(p.Character) then
                    closest = p.Character
                    dist = d
                end
            end
        end
    end
    if closest then
        if not espHighlight or espHighlight.Adornee ~= closest then
            if espHighlight then espHighlight:Destroy() end
            espHighlight = Instance.new("Highlight")
            espHighlight.Adornee = closest
            espHighlight.FillColor = getAccentColor()
            espHighlight.FillTransparency = 0.5
            espHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            espHighlight.Parent = closest
        end
    else
        if espHighlight then espHighlight:Destroy() espHighlight = nil end
    end
end)

