local function spawnRipple(pos)
    for i = 1, 4 do
        task.delay(i * 0.04, function()
            local ring = Instance.new("Part")
            ring.Shape = Enum.PartType.Cylinder
            ring.Size = Vector3.new(0.1, 1, 1)
            ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
            ring.Anchored = true
            ring.CanCollide = false
            ring.Material = Enum.Material.Neon
            ring.Color = getAccentColor()
            ring.Transparency = 0.5
            ring.Parent = workspace
            local tween = TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = Vector3.new(0.1, (10 + i * 3) * settings.rippleSize, (10 + i * 3) * settings.rippleSize),
                Transparency = 1
            })
            tween:Play()
            tween.Completed:Connect(function() ring:Destroy() end)
        end)
    end
end

local wasJumping = false
RunService.Heartbeat:Connect(function()
    if not settings.landingCircleEnabled then return end
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local state = hum:GetState()
    local isJumping = state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall
    if isJumping ~= wasJumping then
        wasJumping = isJumping
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then spawnRipple(hrp.Position - Vector3.new(0, 3, 0)) end
    end
end)

local baseThemes = {
    {name = "Фиолетовая", hue = 270},
    {name = "Синяя", hue = 220},
    {name = "Красная", hue = 0},
    {name = "Зелёная", hue = 120},
    {name = "Розовая", hue = 320},
    {name = "Голубая", hue = 190},
    {name = "Жёлтая", hue = 50},
    {name = "Белая", hue = 0, custom = Color3.fromRGB(240, 240, 240)}
}

local function showThemes()
    for _, child in ipairs(CardContainer:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    SectionTitle.Text = "Темы"
    for i, t in ipairs(baseThemes) do
        local card = Instance.new("Frame", CardContainer)
        card.BackgroundColor3 = t.custom or Color3.fromHSV(t.hue / 360, 0.6, 0.15)
        card.BackgroundTransparency = 0.3
        card.BorderSizePixel = 0
        local cc = Instance.new("UICorner", card)
        cc.CornerRadius = UDim.new(0, 10)
        local title = Instance.new("TextLabel", card)
        title.Size = UDim2.new(1, 0, 0, 20)
        title.Position = UDim2.new(0, 0, 0.2, 0)
        title.BackgroundTransparency = 1
        title.Text = t.name
        title.TextColor3 = Color3.fromRGB(255, 255, 255)
        title.TextSize = 14
        title.Font = Enum.Font.GothamBold
        local btn = Instance.new("TextButton", card)
        btn.Size = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text = ""
        btn.MouseButton1Click:Connect(function()
            if t.custom then
                themeHue = 0
                for _, item in ipairs(themeElements) do
                    if item.obj and item.obj.Parent then
                        if item.prop == "bg" then item.obj.BackgroundColor3 = t.custom
                        elseif item.prop == "accent" then item.obj.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
                        elseif item.prop == "text" then item.obj.TextColor3 = Color3.fromRGB(30, 30, 30)
                        elseif item.prop == "stroke" then item.obj.Color = Color3.fromRGB(200, 200, 200)
                        end
                    end
                end
            else
                themeHue = t.hue
                updateTheme()
            end
        end)
    end

    local hueCard = Instance.new("Frame", CardContainer)
    hueCard.Size = UDim2.new(0.96, 0, 0, 100)
    hueCard.BackgroundColor3 = getThemeColor()
    hueCard.BackgroundTransparency = 0.3
    hueCard.BorderSizePixel = 0
    local hcCorner = Instance.new("UICorner", hueCard)
    hcCorner.CornerRadius = UDim.new(0, 10)
    registerThemeElement(hueCard, "bg")

    local hueLabel = Instance.new("TextLabel", hueCard)
    hueLabel.Size = UDim2.new(1, 0, 0, 20)
    hueLabel.Position = UDim2.new(0, 0, 0.05, 0)
    hueLabel.BackgroundTransparency = 1
    hueLabel.Text = "Свой оттенок: " .. themeHue
    hueLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    hueLabel.TextSize = 14
    hueLabel.Font = Enum.Font.GothamBold

    local slider = Instance.new("TextButton", hueCard)
    slider.Size = UDim2.new(0.9, 0, 0, 20)
    slider.Position = UDim2.new(0.05, 0, 0.4, 0)
    slider.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    slider.Text = ""
    slider.BorderSizePixel = 0
    slider.AutoButtonColor = false
    local sCorner = Instance.new("UICorner", slider)
    sCorner.CornerRadius = UDim.new(1, 0)

    local gradient = Instance.new("UIGradient", slider)
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
    })

    local knob = Instance.new("Frame", slider)
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = UDim2.new(themeHue / 360, -9, 0.5, -9)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    local kCorner = Instance.new("UICorner", knob)
    kCorner.CornerRadius = UDim.new(1, 0)

    local dragging = false
    local function updateFromInput(input)
        local x = input.Position.X
        local absX = slider.AbsolutePosition.X
        local sizeX = slider.AbsoluteSize.X
        if sizeX > 0 then
            local pos = math.clamp((x - absX) / sizeX, 0, 1)
            themeHue = math.floor(pos * 360)
            hueLabel.Text = "Свой оттенок: " .. themeHue
            knob.Position = UDim2.new(pos, -9, 0.5, -9)
            updateTheme()
        end
    end
    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true updateFromInput(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            updateFromInput(input)
        end
    end)
end

