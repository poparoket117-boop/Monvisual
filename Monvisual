local themeHue = 270
local themeCustomColor = nil
local themeIsClear = false
local WHITE = Color3.fromRGB(255, 255, 255)
local BLACK = Color3.fromRGB(0, 0, 0)

local function getThemeColor() return Color3.fromRGB(20,20,30) end
local function getAccentColor()
    if themeIsClear then return WHITE end
    if themeCustomColor then
        return Color3.new(math.min(themeCustomColor.R+0.5,1), math.min(themeCustomColor.G+0.5,1), math.min(themeCustomColor.B+0.5,1))
    end
    return Color3.fromHSV(themeHue/360, 0.7, 0.9)
end
local function getTransparency()
    if themeIsClear then return 0.7 end
    return 0.85
end

