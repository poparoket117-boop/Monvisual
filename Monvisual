local wasInAir = false
RunService.Heartbeat:Connect(function()
    if not _G.Monvisual_Loaded then return end
    if not settings.landingCircleEnabled then wasInAir = false return end
    local char = Player.Character
    if not char then wasInAir = false return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then wasInAir = false return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then wasInAir = false return end
    local state = hum:GetState()
    local inAir = state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Flying
    if wasInAir and not inAir then
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = {char}
        local ray = workspace:Raycast(hrp.Position + Vector3.new(0,2,0), Vector3.new(0,-15,0), rp)
        local groundPos = ray and ray.Position or (hrp.Position - Vector3.new(0,3,0))
        for i=1,4 do
            task.delay(i*0.04, function()
                local ring = Instance.new("Part")
                ring.Shape = Enum.PartType.Cylinder
                ring.Size = Vector3.new(0.1,1,1)
                ring.CFrame = CFrame.new(groundPos) * CFrame.Angles(0,0,math.rad(90))
                ring.Anchored = true ring.CanCollide = false ring.Material = Enum.Material.Neon
                ring.Color = getAccentColor() ring.Transparency = settings.rippleTransparency
                ring.Parent = workspace
                local t = TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = Vector3.new(0.1, (10+i*3)*settings.rippleSize, (10+i*3)*settings.rippleSize),
                    Transparency = 1
                })
                t:Play() t.Completed:Connect(function() ring:Destroy() end)
            end)
        end
    end
    wasInAir = inAir
end)

