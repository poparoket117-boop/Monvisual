local function getThemeColor()
    if themeCustomColor then return themeCustomColor end
    return Color3.fromHSV(themeHue / 360, 0.6, 0.15)
end
local function getAccentColor()
    if themeCustomColor then
        return Color3.new(math.min(themeCustomColor.R + 0.5, 1), math.min(themeCustomColor.G + 0.5, 1), math.min(themeCustomColor.B + 0.5, 1))
    end
    return Color3.fromHSV(themeHue / 360, 0.7, 0.9)
end
local function getTransparency()
    if themeCustomTransparency then return themeCustomTransparency end
    return 0.3
end

