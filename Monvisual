-- Эффект капли (расходящиеся кольца)
local function spawnRipple(pos)
    for i = 1, 3 do
        task.delay(i * 0.05, function()
            local ring = Instance.new("Part")
            ring.Shape = Enum.PartType.Cylinder
            ring.Size = Vector3.new(0.1, 0.5, 0.5)
            ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
            ring.Anchored = true
            ring.CanCollide = false
            ring.Material = Enum.Material.Neon
            ring.Color = getAccentColor()
            ring.Transparency = 0.4
            ring.Parent = workspace

            local tween = TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = Vector3.new(0.1, 8 + i * 2, 8 + i * 2),
                Transparency = 1
            })
            tween:Play()
            tween.Completed:Connect(function()
                ring:Destroy()
            end)
        end)
    end
end

local wasJumping = false
RunService.Heartbeat:Connect(function()
    if not landingCircleEnabled then return end
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local state = hum:GetState()
    local isJumping = state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall

    if isJumping ~= wasJumping then
        wasJumping = isJumping
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then spawnRipple(hrp.Position - Vector3.new(0, 3, 0)) end
    end
end)

