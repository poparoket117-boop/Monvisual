-- ===== КИТАЙСКАЯ ШЛЯПА (EditableMesh) =====
local function ApplyHat()
    if hatCon then hatCon:Disconnect() hatCon = nil end
    if hatModel then hatModel:Destroy() hatModel = nil end
    if not settings.hatEnabled then return end
    local char = Player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    local segments = 64
    local radiusBottom = 2.45
    local radiusTop = 0.32
    local height = settings.hatHeight       -- регулировка
    local wallThickness = 0.08
    local baseColor = Color3.fromHSV(themeHue / 360, settings.hatSaturation, 1)
    local baseTransparency = settings.hatTransparency  -- регулировка

    local success, mesh = pcall(function()
        return AssetService:CreateEditableMesh()
    end)
    if not success or not mesh then return end

    local outerBottom = {}
    local outerTop = {}
    local innerBottom = {}
    local innerTop = {}

    for i = 0, segments - 1 do
        local angle = (i / segments) * math.pi * 2
        local x = math.cos(angle) * radiusBottom
        local z = math.sin(angle) * radiusBottom
        outerBottom[i + 1] = mesh:AddVertex(Vector3.new(x, 0, z))
    end
    for i = 0, segments - 1 do
        local angle = (i / segments) * math.pi * 2
        local x = math.cos(angle) * radiusTop
        local z = math.sin(angle) * radiusTop
        outerTop[i + 1] = mesh:AddVertex(Vector3.new(x, height, z))
    end

    local innerBottomRadius = radiusBottom - wallThickness
    local innerTopRadius = math.max(radiusTop - wallThickness, 0.05)

    for i = 0, segments - 1 do
        local angle = (i / segments) * math.pi * 2
        local x = math.cos(angle) * innerBottomRadius
        local z = math.sin(angle) * innerBottomRadius
        innerBottom[i + 1] = mesh:AddVertex(Vector3.new(x, 0, z))
    end
    for i = 0, segments - 1 do
        local angle = (i / segments) * math.pi * 2
        local x = math.cos(angle) * innerTopRadius
        local z = math.sin(angle) * innerTopRadius
        innerTop[i + 1] = mesh:AddVertex(Vector3.new(x, height, z))
    end

    for i = 1, segments do
        local nxt = (i % segments) + 1
        mesh:AddTriangle(outerBottom[i], outerBottom[nxt], outerTop[i])
        mesh:AddTriangle(outerBottom[nxt], outerTop[nxt], outerTop[i])
    end
    for i = 1, segments do
        local nxt = (i % segments) + 1
        mesh:AddTriangle(innerBottom[i], innerTop[i], innerBottom[nxt])
        mesh:AddTriangle(innerBottom[nxt], innerTop[i], innerTop[nxt])
    end
    for i = 1, segments do
        local nxt = (i % segments) + 1
        mesh:AddTriangle(outerTop[i], outerTop[nxt], innerTop[i])
        mesh:AddTriangle(outerTop[nxt], innerTop[nxt], innerTop[i])
    end

    local ok, cone = pcall(function()
        return AssetService:CreateMeshPartAsync(
            Content.fromObject(mesh),
            { CollisionFidelity = Enum.CollisionFidelity.Hull }
        )
    end)
    if not ok or not cone then return end

    hatModel = Instance.new("Model")
    hatModel.Name = "MonvisualHoloHat"
    hatModel.Parent = char

    cone.Name = "Cone"
    cone.Material = Enum.Material.Neon
    cone.Color = baseColor
    cone.Transparency = baseTransparency
    cone.CanCollide = false
    cone.CanTouch = false
    cone.CanQuery = false
    cone.Massless = true
    cone.Anchored = false
    cone.CFrame = head.CFrame * CFrame.new(0, 1.05, 0)
    cone.Parent = hatModel

    local brim = Instance.new("Part")
    brim.Name = "Brim"
    brim.Shape = Enum.PartType.Cylinder
    brim.Size = Vector3.new(5.1, 0.10, 5.1)
    brim.Material = Enum.Material.Neon
    brim.Color = baseColor
    brim.Transparency = baseTransparency
    brim.CanCollide = false
    brim.CanTouch = false
    brim.CanQuery = false
    brim.Massless = true
    brim.Anchored = false
    brim.CFrame = head.CFrame * CFrame.new(0, 1.02, 0)
    brim.Parent = hatModel

    local weld1 = Instance.new("WeldConstraint")
    weld1.Part0 = head
    weld1.Part1 = cone
    weld1.Parent = cone

    local weld2 = Instance.new("WeldConstraint")
    weld2.Part0 = head
    weld2.Part1 = brim
    weld2.Parent = brim

    local light = Instance.new("PointLight")
    light.Color = baseColor
    light.Brightness = 1.5
    light.Range = 8
    light.Parent = brim

    -- Мерцание
    hatCon = RunService.Heartbeat:Connect(function()
        if not hatModel or not settings.hatEnabled then return end
        if not hatModel.Parent then return end
        local t = tick()
        local flicker = baseTransparency + math.sin(t * 8) * 0.05
        flicker = math.clamp(flicker, 0.05, 0.50)
        local holo = Color3.fromHSV(themeHue / 360, settings.hatSaturation, 1)
        for _, p in ipairs(hatModel:GetChildren()) do
            if p:IsA("BasePart") then
                p.Transparency = flicker
                p.Color = holo
            end
        end
        if light then light.Color = holo end
    end)
end

local function ApplyRTX()
    if settings.rtxShadowsEnabled then
        Lighting.GlobalShadows = true
        Lighting.ShadowSoftness = 1 - settings.rtxShadowsIntensity
        Lighting.Brightness = 2.5
        Lighting.OutdoorAmbient = Color3.fromRGB(90, 90, 110)
        Lighting.Ambient = Color3.fromRGB(60, 60, 80)
        local atmo = Lighting:FindFirstChild("MonvisualAtmo")
        if not atmo then
            atmo = Instance.new("Atmosphere")
            atmo.Name = "MonvisualAtmo"
            atmo.Density = 0.35
            atmo.Offset = 0.1
            atmo.Color = Color3.fromRGB(180, 180, 200)
            atmo.Decay = Color3.fromRGB(100, 100, 130)
            atmo.Glare = 0.2
            atmo.Haze = 1.5
            atmo.Parent = Lighting
        end
        local sun = Lighting:FindFirstChild("MonvisualSun")
        if not sun then
            sun = Instance.new("SunRaysEffect")
            sun.Name = "MonvisualSun"
            sun.Intensity = 0.1
            sun.Spread = 1
            sun.Parent = Lighting
        end
    else
        Lighting.GlobalShadows = true
        Lighting.ShadowSoftness = 0.4
        Lighting.Brightness = 1
        local atmo = Lighting:FindFirstChild("MonvisualAtmo")
        if atmo then atmo:Destroy() end
        local sun = Lighting:FindFirstChild("MonvisualSun")
        if sun then sun:Destroy() end
    end
    if settings.rtxReflectionsEnabled then
        Lighting.EnvironmentDiffuseScale = 1
        Lighting.EnvironmentSpecularScale = 1
    else
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
    end
    if settings.rtxAOEnabled then
        local ao = Lighting:FindFirstChild("MonvisualAO")
        if not ao then
            ao = Instance.new("ColorCorrectionEffect")
            ao.Name = "MonvisualAO"
            ao.Parent = Lighting
        end
        ao.Contrast = settings.rtxAOIntensity
        ao.Brightness = -0.15
        ao.Saturation = -0.1
    else
        local ao = Lighting:FindFirstChild("MonvisualAO")
        if ao then ao:Destroy() end
    end
end
local function ApplyDayNight()
    if settings.dayNightEnabled then
        Lighting.ClockTime = settings.dayNightTime
        Lighting.Brightness = (settings.dayNightTime >= 6 and settings.dayNightTime <= 18) and 2 or 0.5
        Lighting.OutdoorAmbient = (settings.dayNightTime >= 6 and settings.dayNightTime <= 18) and Color3.fromRGB(120,120,140) or Color3.fromRGB(30,30,50)
    else
        Lighting.ClockTime = 14
        Lighting.Brightness = 1
        Lighting.OutdoorAmbient = Color3.fromRGB(70, 70, 70)
    end
end
local function ApplyMotionBlur()
    if not settings.motionBlurEnabled then
        local blur = Lighting:FindFirstChild("MonvisualBlur")
        if blur then blur:Destroy() end
    end
end

local function ApplyAllFunctions()
    ApplyFOV() ApplyFog() ApplySky() ApplySkyParticles() ApplyTrails()
    ApplyRTX() ApplyDayNight() ApplyMotionBlur()
    task.spawn(function()
        if not Player.Character then Player.CharacterAdded:Wait() end
        task.wait(0.5)
        ApplyParticles() ApplyWings() ApplyHat()
    end)
end

