-- КОСМЕТИКА
local wingsFunc = {
    name = "Крылья", desc = "Анимированные крылья.",
    getState = function() return settings.wingsEnabled end,
    settings = function()
        openSettings("Цвет крыльев (HUE)", 0, 360, 270, function(v)
            settings.wingsColor = Color3.fromHSV(v/360, 0.8, 1)
            if wingsModel then
                for _, p in ipairs(wingsModel:GetDescendants()) do
                    if p:IsA("BasePart") then p.Color = settings.wingsColor end
                end
            end
        end)
    end,
    callback = function(on)
        settings.wingsEnabled = on
        if on then
            local char = Player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and not wingsModel then
                    wingsModel = Instance.new("Model")
                    wingsModel.Name = "KimikoWings"
                    wingsModel.Parent = char

                    -- Левое крыло (3 пера)
                    for i = 1, 3 do
                        local wing = Instance.new("Part")
                        wing.Size = Vector3.new(0.2, 2, 0.5)
                        wing.Anchored = false
                        wing.CanCollide = false
                        wing.Material = Enum.Material.Neon
                        wing.Color = settings.wingsColor
                        wing.Transparency = 0.3
                        wing.Parent = wingsModel
                        local weld = Instance.new("Weld")
                        weld.Part0 = hrp
                        weld.Part1 = wing
                        weld.C0 = CFrame.new(-1, 0, 0.5) * CFrame.Angles(0, math.rad(-20 - i*10), 0)
                        weld.Parent = wing
                    end

                    -- Правое крыло
                    for i = 1, 3 do
                        local wing = Instance.new("Part")
                        wing.Size = Vector3.new(0.2, 2, 0.5)
                        wing.Anchored = false
                        wing.CanCollide = false
                        wing.Material = Enum.Material.Neon
                        wing.Color = settings.wingsColor
                        wing.Transparency = 0.3
                        wing.Parent = wingsModel
                        local weld = Instance.new("Weld")
                        weld.Part0 = hrp
                        weld.Part1 = wing
                        weld.C0 = CFrame.new(1, 0, 0.5) * CFrame.Angles(0, math.rad(20 + i*10), 0)
                        weld.Parent = wing
                    end

                    -- Анимация — качание крыльев в стороны (не крутят персонажа)
                    if wingsCon then wingsCon:Disconnect() end
                    wingsCon = RunService.Heartbeat:Connect(function()
                        if not wingsModel or not settings.wingsEnabled then return end
                        local t = tick()
                        local index = 0
                        for _, p in ipairs(wingsModel:GetDescendants()) do
                            if p:IsA("BasePart") then
                                index = index + 1
                                local weld = p:FindFirstChildOfClass("Weld")
                                if weld then
                                    local side = (weld.C0.Position.X < 0) and -1 or 1
                                    local angle = math.sin(t * 3 + index) * math.rad(15) * side
                                    weld.C0 = CFrame.new(weld.C0.Position) * CFrame.Angles(0, math.rad(side * (20 + index * 5)) + angle, 0)
                                end
                            end
                        end
                    end)
                end
            end
        else
            if wingsCon then wingsCon:Disconnect() wingsCon = nil end
            if wingsModel then wingsModel:Destroy() wingsModel = nil end
        end
    end
}

-- Китайская шляпа (рисовая конусная)
local hatFunc = {
    name = "Китайская шляпа", desc = "Рисовая конусная шляпа.",
    getState = function() return settings.hatEnabled end,
    settings = function()
        openSettings("Цвет шляпы (HUE)", 0, 360, 30, function(v)
            settings.hatColor = Color3.fromHSV(v/360, 0.6, 0.9)
            if hatModel then
                for _, p in ipairs(hatModel:GetDescendants()) do
                    if p:IsA("BasePart") then p.Color = settings.hatColor end
                end
            end
        end)
    end,
    callback = function(on)
        settings.hatEnabled = on
        if on then
            local char = Player.Character
            if char then
                local head = char:FindFirstChild("Head")
                if head and not hatModel then
                    hatModel = Instance.new("Model")
                    hatModel.Name = "KimikoHat"
                    hatModel.Parent = char

                    -- Конус (основа шляпы)
                    local cone = Instance.new("Part")
                    cone.Shape = Enum.PartType.Cylinder
                    cone.Size = Vector3.new(2, 0.1, 0.1)
                    cone.Anchored = false
                    cone.CanCollide = false
                    cone.Material = Enum.Material.SmoothPlastic
                    cone.Color = settings.hatColor
                    cone.Parent = hatModel

                    local weld = Instance.new("Weld")
                    weld.Part0 = head
                    weld.Part1 = cone
                    weld.C0 = CFrame.new(0, 1.8, 0) * CFrame.Angles(0, 0, math.rad(90))
                    weld.Parent = cone

                    -- Верхушка (маленький конус)
                    local top = Instance.new("Part")
                    top.Shape = Enum.PartType.Cylinder
                    top.Size = Vector3.new(0.8, 0.05, 0.05)
                    top.Anchored = false
                    top.CanCollide = false
                    top.Material = Enum.Material.SmoothPlastic
                    top.Color = settings.hatColor
                    top.Parent = hatModel

                    local weld2 = Instance.new("Weld")
                    weld2.Part0 = head
                    weld2.Part1 = top
                    weld2.C0 = CFrame.new(0, 2.2, 0) * CFrame.Angles(0, 0, math.rad(90))
                    weld2.Parent = top
                end
            end
        else
            if hatModel then hatModel:Destroy() hatModel = nil end
        end
    end
}

