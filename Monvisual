    if not char then char = Player.CharacterAdded:Wait() end
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end
    particleAttachment = Instance.new("Attachment", hrp)
    particleEmitter = Instance.new("ParticleEmitter")
    particleEmitter.Texture = "rbxassetid://296874871"
    particleEmitter.Rate = 0
    particleEmitter.Lifetime = NumberRange.new(1, 1.8)
    particleEmitter.Speed = NumberRange.new(3, 6)
    particleEmitter.SpreadAngle = Vector2.new(180, 180)
    particleEmitter.Color = ColorSequence.new(getAccentColor())
    particleEmitter.Size = NumberSequence.new(0.8, 0)
    particleEmitter.Transparency = NumberSequence.new(0, 1)
    particleEmitter.Parent = particleAttachment
end
