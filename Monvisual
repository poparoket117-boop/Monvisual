local function createCards(list)
    for _, child in ipairs(CardContainer:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    for i, f in ipairs(list) do
        local card = Instance.new("Frame", CardContainer)
        card.BackgroundColor3 = getThemeColor()
        card.BackgroundTransparency = 0.3
        card.BorderSizePixel = 0
        local cc = Instance.new("UICorner", card)
        cc.CornerRadius = UDim.new(0, 10)
        reg(card, "bg")

        local stroke = Instance.new("UIStroke", card)
        stroke.Color = getAccentColor()
        stroke.Thickness = 1
        reg(stroke, "stroke")

        -- Название карточки
        local title = Instance.new("TextLabel", card)
        title.Size = UDim2.new(1, -70, 0, 18)
        title.Position = UDim2.new(0, 8, 0, 5)
        title.BackgroundTransparency = 1
        title.Text = f.name
        title.TextColor3 = Color3.fromRGB(255,255,255)
        title.TextSize = 12
        title.Font = Enum.Font.GothamBold
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextTruncate = Enum.TextTruncate.AtEnd

        -- Описание
        local desc = Instance.new("TextLabel", card)
        desc.Size = UDim2.new(1, -16, 0, 24)
        desc.Position = UDim2.new(0, 8, 0, 26)
        desc.BackgroundTransparency = 1
        desc.Text = f.desc
        desc.TextColor3 = Color3.fromRGB(180,170,210)
        desc.TextSize = 10
        desc.Font = Enum.Font.Gotham
        desc.TextWrapped = true
        desc.TextXAlignment = Enum.TextXAlignment.Left
        desc.TextYAlignment = Enum.TextYAlignment.Top

        -- Кнопка настроек (шестерёнка)
        if f.settings then
            local setBtn = Instance.new("TextButton", card)
            setBtn.Size = UDim2.new(0, 20, 0, 20)
            setBtn.Position = UDim2.new(1, -50, 0, 5)
            setBtn.BackgroundColor3 = getAccentColor()
            setBtn.Text = "⚙"
            setBtn.TextColor3 = Color3.new(1,1,1)
            setBtn.TextSize = 12
            setBtn.BorderSizePixel = 0
            local setCorner = Instance.new("UICorner", setBtn)
            setCorner.CornerRadius = UDim.new(0, 5)
            reg(setBtn, "accent")
            setBtn.MouseButton1Click:Connect(function() f.settings() end)
        end

        -- Переключатель
        local toggle = Instance.new("TextButton", card)
        toggle.Size = UDim2.new(0, 26, 0, 14)
        toggle.Position = UDim2.new(1, -26, 0, 6)
        toggle.BackgroundColor3 = Color3.fromRGB(50,40,80)
        toggle.Text = ""
        toggle.BorderSizePixel = 0
        local tc = Instance.new("UICorner", toggle)
        tc.CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame", toggle)
        knob.Size = UDim2.new(0, 10, 0, 10)
        knob.Position = UDim2.new(0, 2, 0.5, -5)
        knob.BackgroundColor3 = Color3.fromRGB(200,200,200)
        knob.BorderSizePixel = 0
        local kc = Instance.new("UICorner", knob)
        kc.CornerRadius = UDim.new(1, 0)

        if f.getState and f.getState() then
            toggle.BackgroundColor3 = getAccentColor()
            knob.Position = UDim2.new(1, -12, 0.5, -5)
        end

        toggle.MouseButton1Click:Connect(function()
            if f.getState then
                local newState = not f.getState()
                f.callback(newState)
                if newState then
                    toggle.BackgroundColor3 = getAccentColor()
                    knob.Position = UDim2.new(1, -12, 0.5, -5)
                else
                    toggle.BackgroundColor3 = Color3.fromRGB(50,40,80)
                    knob.Position = UDim2.new(0, 2, 0.5, -5)
                end
            end
        end)
        reg(toggle, "accent")
    end
    task.wait()
    CardContainer.CanvasSize = UDim2.new(0, 0, 0, grid.AbsoluteContentSize.Y + 10)
end

