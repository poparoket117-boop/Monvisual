-- Movement Trails (шлейф за персонажем)
local trailsFunc = {
    name = "Movement Trails", desc = "Шлейф за персонажем.",
    getState = function() return settings.trailsEnabled end,
    callback = function(on)
        settings.trailsEnabled = on
        if on then
            if trailFolder then trailFolder:Destroy() end
            trailFolder = Instance.new("Folder")
            trailFolder.Name = "KimikoTrails"
            trailFolder.Parent = workspace
            if trailCon then trailCon:Disconnect() end
            trailCon = RunService.Heartbeat:Connect(function()
                if not settings.trailsEnabled then return end
                local char = Player.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum or hum.MoveDirection.Magnitude < 0.1 then return end

                local trail = Instance.new("Part")
                trail.Size = Vector3.new(0.3, 0.3, 0.3)
                trail.CFrame = hrp.CFrame * CFrame.new(0, -2, 0)
                trail.Anchored = true
                trail.CanCollide = false
                trail.Material = Enum.Material.Neon
                trail.Color = getAccentColor()
                trail.Transparency = 0.3
                trail.Parent = trailFolder

                local tween = TweenService:Create(trail, TweenInfo.new(1, Enum.EasingStyle.Linear), {
                    Transparency = 1,
                    Size = Vector3.new(0.1, 0.1, 0.1)
                })
                tween:Play()
                tween.Completed:Connect(function() trail:Destroy() end)
            end)
        else
            if trailCon then trailCon:Disconnect() trailCon = nil end
            if trailFolder then trailFolder:Destroy() trailFolder = nil end
        end
    end
}

