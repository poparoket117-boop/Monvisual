local function openSettings(title, sliders)
    local existing = ScreenGui:FindFirstChild("Settings_" .. title)
    if existing then existing:Destroy() return end
    local count = #sliders
    local h = 60 + count * 55
    local SF = Instance.new("Frame", ScreenGui)
    SF.Name = "Settings_" .. title
    SF.Size = UDim2.new(0, 320, 0, h)
    SF.Position = UDim2.new(0.5, -160, 0.5, -h/2)
    SF.BackgroundColor3 = getThemeColor()
    SF.BackgroundTransparency = getTransparency()
    SF.BorderSizePixel = 0
    local sfc = Instance.new("UICorner", SF)
    sfc.CornerRadius = UDim.new(0, 12)
    reg(SF, "bg")

    local t = Instance.new("TextLabel", SF)
    t.Size = UDim2.new(1, 0, 0, 28)
    t.Position = UDim2.new(0, 0, 0, 10)
    t.BackgroundTransparency = 1
    t.Text = title
    t.TextColor3 = getAccentColor()
    t.TextSize = 15
    t.Font = Enum.Font.GothamBold
    reg(t, "text")

    local closeB = Instance.new("TextButton", SF)
    closeB.Size = UDim2.new(0, 26, 0, 26)
    closeB.Position = UDim2.new(1, -32, 0, 7)
    closeB.BackgroundTransparency = 1
    closeB.Text = "✕"
    closeB.TextColor3 = Color3.fromRGB(255,100,100)
    closeB.TextSize = 16
    closeB.Font = Enum.Font.GothamBold
    closeB.MouseButton1Click:Connect(function() SF:Destroy() end)

    for i, s in ipairs(sliders) do
        local yB = 50 + (i-1) * 55
        local lbl = Instance.new("TextLabel", SF)
        lbl.Size = UDim2.new(0.9, 0, 0, 18)
        lbl.Position = UDim2.new(0.05, 0, 0, yB)
        lbl.BackgroundTransparency = 1
        lbl.Text = s.name .. ": " .. string.format("%.2f", s.default)
        lbl.TextColor3 = Color3.fromRGB(220,220,220)
        lbl.TextSize = 12
        lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        local slider = Instance.new("TextButton", SF)
        slider.Size = UDim2.new(0.9, 0, 0, 16)
        slider.Position = UDim2.new(0.05, 0, 0, yB + 22)
        slider.BackgroundColor3 = Color3.fromRGB(50,40,80)
        slider.Text = ""
        slider.BorderSizePixel = 0
        slider.AutoButtonColor = false
        local sc = Instance.new("UICorner", slider)
        sc.CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame", slider)
        fill.Size = UDim2.new((s.default-s.min)/(s.max-s.min), 0, 1, 0)
        fill.BackgroundColor3 = getAccentColor()
        fill.BorderSizePixel = 0
        local fc = Instance.new("UICorner", fill)
        fc.CornerRadius = UDim.new(1, 0)
        reg(fill, "accent")

        local knob = Instance.new("Frame", slider)
        knob.Size = UDim2.new(0, 14, 1, 0)
        knob.Position = UDim2.new((s.default-s.min)/(s.max-s.min), -7, 0, 0)
        knob.BackgroundColor3 = Color3.new(1,1,1)
        knob.BorderSizePixel = 0
        local kc = Instance.new("UICorner", knob)
        kc.CornerRadius = UDim.new(1, 0)

        local dragging = false
        local function updateFromInput(input)
            local x = input.Position.X
            local absX = slider.AbsolutePosition.X
            local sizeX = slider.AbsoluteSize.X
            if sizeX > 0 then
                local pos = math.clamp((x - absX) / sizeX, 0, 1)
                fill.Size = UDim2.new(pos, 0, 1, 0)
                knob.Position = UDim2.new(pos, -7, 0, 0)
                local val = s.min + pos * (s.max - s.min)
                lbl.Text = s.name .. ": " .. string.format("%.2f", val)
                s.callback(val)
            end
        end
        slider.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                updateFromInput(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
                updateFromInput(input)
            end
        end)
    end
end

