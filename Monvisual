            local setCorner = Instance.new("UICorner", setBtn) setCorner.CornerRadius = UDim.new(0, 5)
            setBtn.MouseButton1Click:Connect(function() f.settings() end)
        end
        local toggle = Instance.new("TextButton", card)
        toggle.Size = UDim2.new(0, 22, 0, 12) toggle.Position = UDim2.new(1, -26, 0, 6)
        toggle.BackgroundColor3 = WHITE toggle.Text = "OFF"
        toggle.TextColor3 = BLACK toggle.TextSize = 8 toggle.Font = Enum.Font.GothamBold
        toggle.BorderSizePixel = 0 toggle.AutoButtonColor = false
        local tc = Instance.new("UICorner", toggle) tc.CornerRadius = UDim.new(1, 0)
