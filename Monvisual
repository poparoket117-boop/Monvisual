            local setBtn = Instance.new("TextButton", card)
            setBtn.Size = UDim2.new(0, 20, 0, 20) setBtn.Position = UDim2.new(1, -50, 0, 5)
            setBtn.BackgroundColor3 = getAccentColor() setBtn.Text = "⚙"
