    getState = function() return settings.skyShaderEnabled end,
    callback = function(on)
        settings.skyShaderEnabled = on
        if on then
            local existing = Lighting:FindFirstChild("KimikoSky")
            if existing then existing:Destroy() end
            local sky = Instance.new("Sky")
            sky.Name = "KimikoSky"
            sky.SkyboxBk = "rbxassetid://" .. settings.skyShaderID
            sky.SkyboxDn = "rbxassetid://" .. settings.skyShaderID
            sky.SkyboxFt = "rbxassetid://" .. settings.skyShaderID
            sky.SkyboxLf = "rbxassetid://" .. settings.skyShaderID
            sky.SkyboxRt = "rbxassetid://" .. settings.skyShaderID
            sky.SkyboxUp = "rbxassetid://" .. settings.skyShaderID
            sky.Parent = Lighting
        else
            local sky = Lighting:FindFirstChild("KimikoSky")
