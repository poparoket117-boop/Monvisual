RunService.RenderStepped:Connect(function()
    if not settings.motionBlurEnabled then return end
    local current = Camera.CFrame
    local delta = (current.Position - lastCameraCFrame.Position).Magnitude
    local rotDelta = (current.LookVector - lastCameraCFrame.LookVector).Magnitude
    local movement = delta + rotDelta * 0.5
    local blur = Lighting:FindFirstChild("KimikoBlur")
    if not blur then
        blur = Instance.new("BlurEffect")
        blur.Name = "KimikoBlur"
        blur.Parent = Lighting
    end
    blur.Size = math.clamp(movement * settings.motionBlurAmount * 20, 0, settings.motionBlurAmount)
    lastCameraCFrame = current
end)

