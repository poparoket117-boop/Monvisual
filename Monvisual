    skyParticlesEnabled = false, skyParticlesDensity = 10,
    trailsEnabled = false, trailsTransparency = 0.5,
    deathEffectEnabled = false,
    headlessEnabled = false,
    rtxShadowsEnabled = false, rtxShadowsIntensity = 0.7,
    rtxReflectionsEnabled = false,
    glowEnabled = false, glowIntensity = 3,
    auraEnabled = false, auraBrightness = 5, auraRange = 20,
    dayNightEnabled = false, dayNightTime = 12
}

local CONFIG_FILE = "Monvisual_config.json"
local function SaveConfig()
    local data = {}
    for k,v in pairs(settings) do data[k]=v end
    data.themeHue=themeHue data.themeIsClear=themeIsClear
    pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(data)) end)
end
local function LoadConfig()
    if not isfile(CONFIG_FILE) then return end
    local ok,data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
    if not ok or not data then return end
    for k,v in pairs(data) do
        if k=="themeHue" then themeHue=v
        elseif k=="themeIsClear" then themeIsClear=v
        elseif settings[k]~=nil then settings[k]=v end
    end
end
LoadConfig()

