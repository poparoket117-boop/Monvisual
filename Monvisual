end
local function ApplySkyParticles()
    if skyParticleFolder then skyParticleFolder:Destroy() skyParticleFolder=nil end
    if not settings.skyParticlesEnabled then return end
    skyParticleFolder = Instance.new("Folder")
    skyParticleFolder.Name = "MonvisualSkyParticles"
    skyParticleFolder.Parent = workspace
    task.spawn(function()
        while settings.skyParticlesEnabled and _G.Monvisual_Loaded do
            local char = Player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local count = math.max(1, math.floor(settings.skyParticlesDensity))
                    for i=1,count do
                        local d = Instance.new("Part")
                        d.Size = Vector3.new(0.5,0.5,0.5)
                        d.CFrame = CFrame.new(hrp.Position + Vector3.new(math.random(-40,40), math.random(20,60), math.random(-40,40))) * CFrame.Angles(math.rad(45), math.rad(45), 0)
                        d.Anchored = true d.CanCollide = false d.Material = Enum.Material.Neon
                        d.Color = getAccentColor() d.Transparency = 0.3 d.Parent = skyParticleFolder
                        local t = TweenService:Create(d, TweenInfo.new(2, Enum.EasingStyle.Linear), {Position = d.Position + Vector3.new(0,-20,0), Transparency = 1})
                        t:Play() t.Completed:Connect(function() d:Destroy() end)
                    end
                end
            end
            task.wait(0.15)
        end
    end)
end
local function ApplyTrails()
    if trailCon then trailCon:Disconnect() trailCon=nil end
    if trailFolder then trailFolder:Destroy() trailFolder=nil end
    if not settings.trailsEnabled then return end
    trailFolder = Instance.new("Folder")
    trailFolder.Name = "MonvisualTrails"
    trailFolder.Parent = workspace
    trailCon = RunService.Heartbeat:Connect(function()
        if not _G.Monvisual_Loaded then return end
        if not settings.trailsEnabled then return end
        local char = Player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.MoveDirection.Magnitude < 0.1 then return end
        local trail = Instance.new("Part")
        trail.Size = Vector3.new(0.5,3,0.5)
        trail.CFrame = hrp.CFrame
        trail.Anchored = true trail.CanCollide = false trail.Material = Enum.Material.Neon
        trail.Color = getAccentColor() trail.Transparency = settings.trailsTransparency
        trail.Parent = trailFolder
        local t = TweenService:Create(trail, TweenInfo.new(0.8, Enum.EasingStyle.Linear), {Transparency = 1, Size = Vector3.new(0.2,0.5,0.2)})
        t:Play() t.Completed:Connect(function() trail:Destroy() end)
    end)
end
local function ApplyHeadless()
    if headlessConnection then headlessConnection:Disconnect() headlessConnection=nil end
    local function hide(c)
        local h = c:WaitForChild("Head", 5)
        if not h then return end
        h.LocalTransparencyModifier = 1
        for _,o in ipairs(h:GetDescendants()) do
            if o:IsA("Decal") or o:IsA("Texture") then o.Transparency = 1
            elseif o:IsA("BasePart") then o.LocalTransparencyModifier = 1 end
        end
    end
    local function restore(c)
        local h = c:FindFirstChild("Head")
        if not h then return end
        h.LocalTransparencyModifier = 0
        for _,o in ipairs(h:GetDescendants()) do
            if o:IsA("Decal") or o:IsA("Texture") then o.Transparency = 0
            elseif o:IsA("BasePart") then o.LocalTransparencyModifier = 0 end
        end
    end
    if settings.headlessEnabled then
        if Player.Character then hide(Player.Character) end
        headlessConnection = RunService.Stepped:Connect(function()
            if not _G.Monvisual_Loaded then return end
            if not settings.headlessEnabled then return end
            local c = Player.Character
            if not c then return end
            hide(c)
        end)
    else
        if Player.Character then restore(Player.Character) end
    end
end
local function ApplyRTX()
    if settings.rtxShadowsEnabled then
        Lighting.GlobalShadows = true
        Lighting.ShadowSoftness = 1 - settings.rtxShadowsIntensity
        Lighting.Brightness = 2.5
        Lighting.OutdoorAmbient = Color3.fromRGB(90,90,110)
        Lighting.Ambient = Color3.fromRGB(60,60,80)
        if not Lighting:FindFirstChild("MonvisualAtmo") then
            local atmo = Instance.new("Atmosphere")
            atmo.Name = "MonvisualAtmo" atmo.Density = 0.35 atmo.Parent = Lighting
        end
    else
        Lighting.GlobalShadows = true Lighting.Brightness = 1
        local atmo = Lighting:FindFirstChild("MonvisualAtmo")
        if atmo then atmo:Destroy() end
    end
    if settings.rtxReflectionsEnabled then
        Lighting.EnvironmentDiffuseScale = 1 Lighting.EnvironmentSpecularScale = 1
    else
        Lighting.EnvironmentDiffuseScale = 0 Lighting.EnvironmentSpecularScale = 0
    end
end
local function ApplyGlow()
    local existing = Lighting:FindFirstChild("MonvisualBloom")
    if settings.glowEnabled then
        if not existing then
            existing = Instance.new("BloomEffect")
            existing.Name = "MonvisualBloom" existing.Parent = Lighting
        end
        existing.Intensity = settings.glowIntensity
        existing.Size = 40 existing.Threshold = 0.1 existing.Enabled = true
    else
        if existing then existing:Destroy() end
    end
end
local function ApplyAura()
    if auraLight then pcall(function() auraLight:Destroy() end) auraLight=nil end
    if auraAttachment then pcall(function() auraAttachment:Destroy() end) auraAttachment=nil end
    if not settings.auraEnabled then return end
    local c = Player.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    auraAttachment = Instance.new("Attachment", hrp)
    auraLight = Instance.new("PointLight", auraAttachment)
    auraLight.Brightness = settings.auraBrightness
    auraLight.Range = settings.auraRange
    auraLight.Color = getAccentColor()
    auraLight.Shadows = false
end
local function ApplyDayNight()
    if settings.dayNightEnabled then
        Lighting.ClockTime = settings.dayNightTime
        Lighting.Brightness = (settings.dayNightTime >= 6 and settings.dayNightTime <= 18) and 2 or 0.5
        Lighting.OutdoorAmbient = (settings.dayNightTime >= 6 and settings.dayNightTime <= 18) and Color3.fromRGB(120,120,140) or Color3.fromRGB(30,30,50)
    else
        Lighting.ClockTime = 14 Lighting.Brightness = 1 Lighting.OutdoorAmbient = Color3.fromRGB(70,70,70)
    end
end
local function ApplyDeathEffect()
    for _,c in ipairs(deathConnections) do pcall(function() c:Disconnect() end) end
    deathConnections = {}
    if not settings.deathEffectEnabled then return end
    local function playDeath(char)
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local pos = root.Position
        local fogPart = Instance.new("Part")
        fogPart.Size = Vector3.new(1,1,1) fogPart.Position = pos - Vector3.new(0,2,0)
        fogPart.Anchored = true fogPart.CanCollide = false fogPart.Transparency = 1
        fogPart.Parent = workspace
        local att = Instance.new("Attachment", fogPart)
        local smoke = Instance.new("ParticleEmitter")
        smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
        smoke.Rate = 0 smoke.Lifetime = NumberRange.new(1,1.5)
        smoke.Speed = NumberRange.new(0.2,0.8) smoke.SpreadAngle = Vector2.new(180,180)
        smoke.Color = ColorSequence.new(getAccentColor())
        smoke.Size = NumberSequence.new({NumberSequenceKeypoint.new(0,2),NumberSequenceKeypoint.new(1,6)})
        smoke.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0.2),NumberSequenceKeypoint.new(1,1)})
        smoke.Parent = att smoke:Emit(70)
        Debris:AddItem(fogPart, 1.5)
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude rp.FilterDescendantsInstances = {char}
        local rr = workspace:Raycast(pos + Vector3.new(0,2,0), Vector3.new(0,-20,0), rp)
        local gy = rr and rr.Position.Y or pos.Y - 3
        local pillar = Instance.new("Part")
        pillar.Shape = Enum.PartType.Cylinder
        pillar.Size = Vector3.new(0.1,0.8,0.8) pillar.Anchored = true pillar.CanCollide = false
        pillar.Material = Enum.Material.Neon pillar.Color = getAccentColor() pillar.Transparency = 0.05
        pillar.CFrame = CFrame.new(pos.X, gy+0.05, pos.Z) * CFrame.Angles(0,0,math.rad(90))
        pillar.Parent = workspace
        TweenService:Create(pillar, TweenInfo.new(3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = Vector3.new(30,0.8,0.8),
            CFrame = CFrame.new(pos.X, gy+15, pos.Z) * CFrame.Angles(0,0,math.rad(90)),
            Transparency = 1
        }):Play()
        task.delay(1, function()
            if not char or not char.Parent then return end
            for _,o in ipairs(char:GetDescendants()) do
                if o:IsA("BasePart") then o.Transparency=1 o.CanCollide=false
                elseif o:IsA("Decal") or o:IsA("Texture") then o.Transparency=1 end
            end
        end)
        task.delay(3, function()
            if pillar and pillar.Parent then pillar:Destroy() end
            if char and char.Parent then char:Destroy() end
        end)
    end
    local function setup(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        local cn = hum.Died:Connect(function()
            if settings.deathEffectEnabled then playDeath(char) end
        end)
        table.insert(deathConnections, cn)
    end
    local function setupP(p)
        local c1 = p.CharacterAdded:Connect(setup)
        table.insert(deathConnections, c1)
        if p.Character then setup(p.Character) end
    end
    local c2 = Players.PlayerAdded:Connect(setupP)
    table.insert(deathConnections, c2)
    for _,p in ipairs(Players:GetPlayers()) do setupP(p) end
end

