    stretchEnabled = false, STRETCH_FACTOR = 0.75,
    fovEnabled = false, fovValue = 90,
    particlesEnabled = false, particlesDensity = 1,
    targetESPEnabled = false,
    landingCircleEnabled = false, rippleSize = 0.1, rippleTransparency = 0.5,
    fogEnabled = false, fogStart = 50, fogEnd = 500,
