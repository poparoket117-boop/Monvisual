        sky.SkyboxFt = "rbxassetid://105721322908215"
        sky.SkyboxLf = "rbxassetid://105721322908215"
        sky.SkyboxRt = "rbxassetid://105721322908215"
        sky.SkyboxUp = "rbxassetid://105721322908215"
