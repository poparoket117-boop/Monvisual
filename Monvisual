            toggle.BackgroundColor3 = BLACK toggle.Text = "ON" toggle.TextColor3 = WHITE
        end
        toggle.MouseButton1Click:Connect(function()
            if f.getState then
                local ns = not f.getState()
                f.callback(ns)
                if ns then toggle.BackgroundColor3 = BLACK toggle.Text = "ON" toggle.TextColor3 = WHITE
                else toggle.BackgroundColor3 = WHITE toggle.Text = "OFF" toggle.TextColor3 = BLACK end
                SaveConfig()
            end
        end)
    end
    task.wait()
    CardContainer.CanvasSize = UDim2.new(0, 0, 0, cardLayout.AbsoluteContentSize.Y + 10)
end

