local function updateTheme()
    if not _G.Monvisual_Loaded then return end
    local accent = getAccentColor()
    local trans = getTransparency()
    Main.BackgroundColor3 = getThemeColor() Main.BackgroundTransparency = trans
    SideBar.BackgroundColor3 = getThemeColor() SideBar.BackgroundTransparency = trans
    Stroke.Color = accent CardContainer.ScrollBarImageColor3 = accent
    for _,btn in ipairs(catButtons) do btn.BackgroundTransparency = trans end
    OpenBtn.BackgroundTransparency = 1
    if OpenStroke then OpenStroke.Color = accent end
    if auraLight then auraLight.Color = accent end
    for _,card in ipairs(CardContainer:GetChildren()) do
        if card:IsA("Frame") then
            card.BackgroundTransparency = trans
            for _,child in ipairs(card:GetChildren()) do
                if child:IsA("UIStroke") then child.Color = accent
                elseif child:IsA("TextButton") and child.Text == "⚙" then child.BackgroundColor3 = accent
                elseif child:IsA("TextButton") and (child.Text == "OFF" or child.Text == "ON") then
                    if child.Text == "ON" then child.BackgroundColor3 = BLACK
                    else child.BackgroundColor3 = WHITE end
                end
            end
        end
    end
    for _,sf in ipairs(ScreenGui:GetChildren()) do
        if sf:IsA("Frame") and sf.Name:sub(1,9) == "Settings_" then
            sf.BackgroundTransparency = trans
            for _,child in ipairs(sf:GetChildren()) do
                if child:IsA("Frame") and child:FindFirstChildOfClass("UICorner") then child.BackgroundColor3 = accent end
            end
        end
    end
end

local function openSettings(title, sliders)
    local existing = ScreenGui:FindFirstChild("Settings_" .. title)
    if existing then existing:Destroy() return end
    local count = #sliders
    local h = 60 + count * 55
    local SF = Instance.new("Frame", ScreenGui)
    SF.Name = "Settings_" .. title
    SF.Size = UDim2.new(0, 320, 0, h)
    SF.Position = UDim2.new(0.5, -160, 0.5, -h/2)
    SF.BackgroundColor3 = getThemeColor() SF.BackgroundTransparency = getTransparency()
    SF.BorderSizePixel = 0 SF.Active = true
    local sfc = Instance.new("UICorner", SF) sfc.CornerRadius = UDim.new(0, 12)
    local t = Instance.new("TextLabel", SF)
    t.Size = UDim2.new(1, 0, 0, 30) t.Position = UDim2.new(0, 0, 0, 10)
    t.BackgroundTransparency = 1 t.Text = title
    t.TextColor3 = WHITE t.TextSize = 15 t.Font = Enum.Font.GothamBold
    local closeB = Instance.new("TextButton", SF)
    closeB.Size = UDim2.new(0, 30, 0, 30) closeB.Position = UDim2.new(1, -35, 0, 5)
    closeB.BackgroundTransparency = 1 closeB.Text = "X"
    closeB.TextColor3 = WHITE closeB.TextSize = 18 closeB.Font = Enum.Font.GothamBold
    closeB.MouseButton1Click:Connect(function() SF:Destroy() end)
    for i,s in ipairs(sliders) do
        local yB = 45 + (i-1) * 55
        local lbl = Instance.new("TextLabel", SF)
        lbl.Size = UDim2.new(0.9, 0, 0, 18)
        lbl.Position = UDim2.new(0.05, 0, 0, yB)
        lbl.BackgroundTransparency = 1
        lbl.Text = s.name .. ": " .. string.format("%.2f", s.default)
        lbl.TextColor3 = WHITE lbl.TextSize = 12 lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        local slider = Instance.new("TextButton", SF)
        slider.Size = UDim2.new(0.9, 0, 0, 16)
        slider.Position = UDim2.new(0.05, 0, 0, yB + 22)
        slider.BackgroundColor3 = Color3.fromRGB(50,40,80)
        slider.Text = "" slider.BorderSizePixel = 0 slider.AutoButtonColor = false
        local sc = Instance.new("UICorner", slider) sc.CornerRadius = UDim.new(1, 0)
        local fill = Instance.new("Frame", slider)
        fill.Size = UDim2.new((s.default-s.min)/(s.max-s.min), 0, 1, 0)
        fill.BackgroundColor3 = getAccentColor() fill.BorderSizePixel = 0
        local fc = Instance.new("UICorner", fill) fc.CornerRadius = UDim.new(1, 0)
        local knob = Instance.new("Frame", slider)
        knob.Size = UDim2.new(0, 14, 1, 0)
        knob.Position = UDim2.new((s.default-s.min)/(s.max-s.min), -7, 0, 0)
        knob.BackgroundColor3 = WHITE knob.BorderSizePixel = 0
        local kc = Instance.new("UICorner", knob) kc.CornerRadius = UDim.new(1, 0)
        local dragging = false
        local function updateFromInput(input)
            local x = input.Position.X
            local absX = slider.AbsolutePosition.X
            local sizeX = slider.AbsoluteSize.X
            if sizeX > 0 then
                local pos = math.clamp((x - absX) / sizeX, 0, 1)
                fill.Size = UDim2.new(pos, 0, 1, 0)
                knob.Position = UDim2.new(pos, -7, 0, 0)
                local val = s.min + pos * (s.max - s.min)
                lbl.Text = s.name .. ": " .. string.format("%.2f", val)
                s.callback(val) SaveConfig()
            end
        end
        slider.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true updateFromInput(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
                updateFromInput(input)
            end
        end)
    end
end

