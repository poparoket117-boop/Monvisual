local function toggleMenu(show)
    if show then
        Main.Visible = true
        Main.BackgroundTransparency = 1
        TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = getTransparency()
        }):Play()
    else
        local fadeTween = TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            BackgroundTransparency = 1
        })
        fadeTween:Play()
        for _, d in ipairs(Main:GetDescendants()) do
            if d:IsA("Frame") or d:IsA("TextButton") or d:IsA("TextLabel") then
                TweenService:Create(d, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
            end
        end
        fadeTween.Completed:Connect(function()
            Main.Visible = false
            Main.BackgroundTransparency = getTransparency()
            for _, d in ipairs(Main:GetDescendants()) do
                if d:IsA("Frame") and d ~= Main then
                    d.BackgroundTransparency = 0.3
                elseif d:IsA("TextButton") or d:IsA("TextLabel") then
                    d.BackgroundTransparency = 0
                end
            end
        end)
    end
end

