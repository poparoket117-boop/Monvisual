-- Партиклы неба (ромбики, много)
local skyParticlesFunc = {
    name = "Партиклы неба", desc = "Ромбики в небе.",
    getState = function() return settings.skyParticlesEnabled end,
    settings = function()
        openSettings("Плотность", 3, 30, settings.skyParticlesDensity, function(v)
            settings.skyParticlesDensity = math.floor(v)
        end)
    end,
    callback = function(on)
        settings.skyParticlesEnabled = on
        if on then
            if skyParticleFolder then skyParticleFolder:Destroy() end
            skyParticleFolder = Instance.new("Folder")
            skyParticleFolder.Name = "KimikoSkyParticles"
            skyParticleFolder.Parent = workspace
            task.spawn(function()
                while settings.skyParticlesEnabled do
                    local char = Player.Character
                    if char then
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            for i = 1, settings.skyParticlesDensity do
                                local diamond = Instance.new("Part")
                                diamond.Size = Vector3.new(0.5, 0.5, 0.5)
                                diamond.CFrame = CFrame.new(
                                    hrp.Position + Vector3.new(
                                        math.random(-40, 40),
                                        math.random(20, 60),
                                        math.random(-40, 40)
                                    )
                                ) * CFrame.Angles(math.rad(45), math.rad(45), 0)
                                diamond.Anchored = true
                                diamond.CanCollide = false
                                diamond.Material = Enum.Material.Neon
                                diamond.Color = getAccentColor()
                                diamond.Transparency = 0.3
                                diamond.Parent = skyParticleFolder

                                local tween = TweenService:Create(diamond, TweenInfo.new(2, Enum.EasingStyle.Linear), {
                                    Position = diamond.Position + Vector3.new(0, -20, 0),
                                    Transparency = 1
                                })
                                tween:Play()
                                tween.Completed:Connect(function() diamond:Destroy() end)
                            end
                        end
                    end
                    task.wait(0.15)
                end
                if skyParticleFolder then
                    skyParticleFolder:Destroy()
                    skyParticleFolder = nil
                end
            end)
        else
            if skyParticleFolder then
                skyParticleFolder:Destroy()
                skyParticleFolder = nil
            end
        end
    end
