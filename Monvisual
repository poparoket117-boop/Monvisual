-- Target ESP
RunService.Heartbeat:Connect(function()
    if not settings.targetESPEnabled then
        for _, d in ipairs(espDiamonds) do if d and d.Parent then d:Destroy() end end
        espDiamonds = {}
        espTargetCFrame = nil
        return
    end
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local closest, closestDist = nil, 30
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local targetHRP = p.Character.HumanoidRootPart
            local d = (targetHRP.Position - hrp.Position).Magnitude
            if d < closestDist then
                closestDist = d
                closest = p.Character
            end
        end
    end
    if closest then
        local targetHRP = closest:FindFirstChild("HumanoidRootPart")
        if targetHRP then
            if #espDiamonds < 8 then
                for _, d in ipairs(espDiamonds) do if d and d.Parent then d:Destroy() end end
                espDiamonds = {}
                for i = 1, 8 do
                    local part = Instance.new("Part")
                    part.Size = Vector3.new(0.7, 0.7, 0.7)
                    part.Anchored = true
                    part.CanCollide = false
                    part.Material = Enum.Material.Neon
                    part.Color = getAccentColor()
                    part.Transparency = 0.2
                    part.CFrame = CFrame.new(0, 0, 0) * CFrame.Angles(math.rad(45), math.rad(45), 0)
                    part.Parent = workspace
                    table.insert(espDiamonds, part)
                end
            end
            espAngle = espAngle + 0.05
            local center = targetHRP.Position
            local radius = 2.5
            if not espTargetCFrame then
                espTargetCFrame = CFrame.new(center)
            else
                local targetCF = CFrame.new(center)
                local dist2 = (espTargetCFrame.Position - center).Magnitude
                local alpha = dist2 > 20 and 0.03 or 0.15
                espTargetCFrame = espTargetCFrame:Lerp(targetCF, alpha)
            end
            local smoothCenter = espTargetCFrame.Position
            for i, part in ipairs(espDiamonds) do
                if part then
                    local angle = espAngle + (i - 1) * (math.pi * 2 / 8)
                    local x = math.cos(angle) * radius
                    local z = math.sin(angle) * radius
                    local y = math.sin(espAngle * 2 + i) * 1.5
                    part.CFrame = CFrame.new(smoothCenter + Vector3.new(x, y, z)) * CFrame.Angles(math.rad(45), espAngle, math.rad(45))
                    part.Color = getAccentColor()
                end
            end
        end
    else
        for _, d in ipairs(espDiamonds) do if d and d.Parent then d:Destroy() end end
        espDiamonds = {}
        espTargetCFrame = nil
    end
end)

