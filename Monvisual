local function openSettings(title, min, max, default, callback)
    local existing = ScreenGui:FindFirstChild("Settings_" .. title)
    if existing then existing:Destroy() return end
    local SettingsFrame = Instance.new("Frame", ScreenGui)
    SettingsFrame.Name = "Settings_" .. title
    SettingsFrame.Size = UDim2.new(0, 300, 0, 150)
    SettingsFrame.Position = UDim2.new(0.5, -150, 0.5, -75)
    SettingsFrame.BackgroundColor3 = getThemeColor()
    SettingsFrame.BackgroundTransparency = getTransparency()
    SettingsFrame.BorderSizePixel = 0
    SettingsFrame.Active = true
    local sfCorner = Instance.new("UICorner", SettingsFrame)
    sfCorner.CornerRadius = UDim.new(0, 12)
    registerThemeElement(SettingsFrame, "bg")

    local sfTitle = Instance.new("TextLabel", SettingsFrame)
    sfTitle.Size = UDim2.new(1, 0, 0, 25)
    sfTitle.BackgroundTransparency = 1
    sfTitle.Text = title
    sfTitle.TextColor3 = getAccentColor()
    sfTitle.TextSize = 15
    sfTitle.Font = Enum.Font.GothamBold
    registerThemeElement(sfTitle, "text")

    local slider = Instance.new("TextButton", SettingsFrame)
    slider.Size = UDim2.new(0.8, 0, 0, 20)
    slider.Position = UDim2.new(0.1, 0, 0.4, 0)
    slider.BackgroundColor3 = Color3.fromRGB(50, 40, 80)
    slider.Text = ""
    slider.BorderSizePixel = 0
    slider.AutoButtonColor = false
    local sCorner = Instance.new("UICorner", slider)
    sCorner.CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", slider)
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = getAccentColor()
    fill.BorderSizePixel = 0
    local fCorner = Instance.new("UICorner", fill)
    fCorner.CornerRadius = UDim.new(1, 0)
    registerThemeElement(fill, "accent")

    local knob = Instance.new("Frame", slider)
    knob.Size = UDim2.new(0, 16, 1, 0)
    knob.Position = UDim2.new((default - min) / (max - min), -8, 0, 0)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    local kCorner = Instance.new("UICorner", knob)
    kCorner.CornerRadius = UDim.new(1, 0)

    local valueLabel = Instance.new("TextLabel", SettingsFrame)
    valueLabel.Size = UDim2.new(1, 0, 0, 20)
    valueLabel.Position = UDim2.new(0, 0, 0.65, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = "Значение: " .. string.format("%.2f", default)
    valueLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    valueLabel.TextSize = 13
    valueLabel.Font = Enum.Font.Gotham

    local closeBtn = Instance.new("TextButton", SettingsFrame)
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -35, 0, 2)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
    closeBtn.TextSize = 18
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.MouseButton1Click:Connect(function() SettingsFrame:Destroy() end)

    local dragging = false
    local function updateFromInput(input)
        local x = input.Position.X
        local absX = slider.AbsolutePosition.X
        local sizeX = slider.AbsoluteSize.X
        if sizeX > 0 then
            local pos = math.clamp((x - absX) / sizeX, 0, 1)
            fill.Size = UDim2.new(pos, 0, 1, 0)
            knob.Position = UDim2.new(pos, -8, 0, 0)
            local val = min + pos * (max - min)
            valueLabel.Text = "Значение: " .. string.format("%.2f", val)
            callback(val)
            SaveConfig()
        end
    end
    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true updateFromInput(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            updateFromInput(input)
        end
    end)
end

