local themeElements = {}
local function registerThemeElement(obj, prop)
    table.insert(themeElements, {obj = obj, prop = prop})
end

local function updateTheme()
    local base = getThemeColor()
    local accent = getAccentColor()
    local trans = getTransparency()
    for _, item in ipairs(themeElements) do
        if item.obj and item.obj.Parent then
            if item.prop == "bg" then
                item.obj.BackgroundColor3 = base
                item.obj.BackgroundTransparency = trans
            elseif item.prop == "accent" then item.obj.BackgroundColor3 = accent
            elseif item.prop == "text" then item.obj.TextColor3 = accent
            elseif item.prop == "stroke" then item.obj.Color = accent
            end
        end
    end
    if particleEmitter then particleEmitter.Color = ColorSequence.new(accent) end
    for _, d in ipairs(espDiamonds) do
        if d and d.Parent then d.Color = accent end
    end
    if hatModel then
        for _, p in ipairs(hatModel:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Color = Color3.fromHSV(themeHue / 360, settings.hatSaturation, 1)
            end
        end
    end
end

