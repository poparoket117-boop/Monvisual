-- ===== ПЕРЕМЕННЫЕ =====
local particleAttachment, particleEmitter
local espDiamonds = {}
local espAngle = 0
local trailFolder, trailCon
local headlessCon

local themeElements = {}
local function reg(obj, prop) table.insert(themeElements, {obj=obj, prop=prop}) end

local function updateTheme()
    local base = getThemeColor()
    local accent = getAccentColor()
    local trans = getTransparency()
    for _, item in ipairs(themeElements) do
        if item.obj and item.obj.Parent then
            if item.prop=="bg" then
                item.obj.BackgroundColor3 = base
                item.obj.BackgroundTransparency = trans
            elseif item.prop=="accent" then item.obj.BackgroundColor3 = accent
            elseif item.prop=="text" then item.obj.TextColor3 = accent
            elseif item.prop=="stroke" then item.obj.Color = accent
            end
        end
    end
end

-- ===== ФУНКЦИИ =====
local function ApplyFOV()
    Camera.FieldOfView = settings.fovEnabled and settings.fovValue or 70
end
local function ApplyParticles()
    if particleEmitter then particleEmitter:Destroy() particleEmitter=nil end
    if particleAttachment then particleAttachment:Destroy() particleAttachment=nil end
    if not settings.particlesEnabled then return end
    local char = Player.Character or Player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end
    particleAttachment = Instance.new("Attachment", hrp)
    particleEmitter = Instance.new("ParticleEmitter")
    particleEmitter.Texture = "rbxassetid://296874871"
    particleEmitter.Rate = 0
    particleEmitter.Lifetime = NumberRange.new(1, 1.8)
    particleEmitter.Speed = NumberRange.new(3, 6)
    particleEmitter.SpreadAngle = Vector2.new(180, 180)
    particleEmitter.Color = ColorSequence.new(getAccentColor())
    particleEmitter.Size = NumberSequence.new(0.8, 0)
    particleEmitter.Transparency = NumberSequence.new(0, 1)
    particleEmitter.Parent = particleAttachment
end
local function ApplyTrails()
    if trailCon then trailCon:Disconnect() trailCon=nil end
    if trailFolder then trailFolder:Destroy() trailFolder=nil end
    if settings.trailsEnabled then
        trailFolder = Instance.new("Folder")
        trailFolder.Name = "MonvisualTrails"
        trailFolder.Parent = workspace
        trailCon = RunService.Heartbeat:Connect(function()
            if not settings.trailsEnabled then return end
            local char = Player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.MoveDirection.Magnitude < 0.1 then return end
            local trail = Instance.new("Part")
            trail.Size = Vector3.new(0.5, 3, 0.5)
            trail.CFrame = hrp.CFrame
            trail.Anchored = true
            trail.CanCollide = false
            trail.Material = Enum.Material.Neon
            trail.Color = getAccentColor()
            trail.Transparency = settings.trailsTransparency
            trail.Parent = trailFolder
            local tween = TweenService:Create(trail, TweenInfo.new(0.8), {Transparency=1, Size=Vector3.new(0.2,0.5,0.2)})
            tween:Play()
            tween.Completed:Connect(function() trail:Destroy() end)
        end)
    end
end
local function ApplyHeadless()
    if headlessCon then headlessCon:Disconnect() headlessCon=nil end
    local char = Player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    local neck = head:FindFirstChildOfClass("Motor6D")
    if not neck then return end
    if settings.headlessEnabled then
        neck.C0 = CFrame.new(0, -100, 0) * CFrame.Angles(math.rad(-90), 0, math.rad(180))
        headlessCon = RunService.Heartbeat:Connect(function()
            if not settings.headlessEnabled then return end
            local c = Player.Character
            if not c then return end
            local h = c:FindFirstChild("Head")
            if not h then return end
            local n = h:FindFirstChildOfClass("Motor6D")
            if n then n.C0 = CFrame.new(0, -100, 0) * CFrame.Angles(math.rad(-90), 0, math.rad(180)) end
        end)
    else
        neck.C0 = CFrame.new(0, 1, 0) * CFrame.Angles(math.rad(-90), 0, math.rad(180))
    end
end
local function ApplyRTX()
    if settings.rtxShadowsEnabled then
        Lighting.Brightness = 2.5
        Lighting.OutdoorAmbient = Color3.fromRGB(90,90,110)
        local atmo = Lighting:FindFirstChild("MonvisualAtmo")
        if not atmo then
            atmo = Instance.new("Atmosphere")
            atmo.Name = "MonvisualAtmo"
            atmo.Density = 0.35
            atmo.Parent = Lighting
        end
    else
        Lighting.Brightness = 1
        Lighting.OutdoorAmbient = Color3.fromRGB(70,70,70)
        local atmo = Lighting:FindFirstChild("MonvisualAtmo")
        if atmo then atmo:Destroy() end
    end
    Lighting.EnvironmentDiffuseScale = settings.rtxReflectionsEnabled and 1 or 0
    Lighting.EnvironmentSpecularScale = settings.rtxReflectionsEnabled and 1 or 0
    if settings.rtxAOEnabled then
        local ao = Lighting:FindFirstChild("MonvisualAO")
        if not ao then
            ao = Instance.new("ColorCorrectionEffect")
            ao.Name = "MonvisualAO"
            ao.Parent = Lighting
        end
        ao.Contrast = settings.rtxAOIntensity
        ao.Brightness = -0.15
    else
        local ao = Lighting:FindFirstChild("MonvisualAO")
        if ao then ao:Destroy() end
    end
end
local function ApplyDayNight()
    if settings.dayNightEnabled then
        Lighting.ClockTime = settings.dayNightTime
        Lighting.Brightness = (settings.dayNightTime>=6 and settings.dayNightTime<=18) and 2 or 0.5
    else
        Lighting.ClockTime = 14
        Lighting.Brightness = 1
    end
end

